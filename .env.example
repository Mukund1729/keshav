# AYUNEXIS HEALTH-TECH PLATFORM — ENVIRONMENT CONFIGURATION
# Vite requires all client-accessible environment variables to begin with VITE_

# Application Metadata
VITE_APP_NAME=Ayunexis Private Limited
VITE_APP_TAGLINE=Elevating Your Health at Every Step
VITE_APP_URL=https://ayunexis.vercel.app

# Backend API Configuration
VITE_API_BASE_URL=https://api.ayunexis.com/api/v1
VITE_API_TIMEOUT_MS=15000

# Payment Gateway (Razorpay Sandbox/Production)
VITE_RAZORPAY_KEY_ID=rzp_test_ayunexis_sample_key
VITE_CURRENCY=INR

# Telehealth & Video Consultation (WebRTC / Zoom / Google Meet)
VITE_WEBRTC_SIGNALING_SERVER=wss://telehealth.ayunexis.com
VITE_TELEHEALTH_PROVIDER=webrtc_direct

# Healthcare Compliance & National Health Authority (ABDM)
VITE_ABDM_SANDBOX=true
VITE_ABDM_CLIENT_ID=ayunexis_health_repo_client

# Communication Channels
VITE_SUPPORT_EMAIL=partnerships@ayunexis.com
VITE_SUPPORT_PHONE=+911244920298
